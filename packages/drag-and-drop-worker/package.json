{
  "name": "@lvce-editor/drag-and-drop-worker",
  "version": "0.0.0-dev",
  "description": "Drag and Drop Worker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvce-editor/drag-and-drop-worker.git"
  },
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "main": "src/dragAndDropWorkerMain.ts",
  "scripts": {
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch"
  },
  "jest": {
    "injectGlobals": false,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "testMatch": [
      "**/test/**"
    ],
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90
      }
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@lvce-editor/rpc": "^6.19.1",
    "@lvce-editor/rpc-registry": "^9.55.0",
    "@types/node": "^24.8.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12"
  }
}
